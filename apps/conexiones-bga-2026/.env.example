# Copiar a .env.local para desarrollo (nunca se commitea) y configurar los
# mismos valores como Environment Variables del proyecto en Vercel para
# producción. Sin estas variables el formulario sigue respondiendo "ok" pero
# no entrega el lead a ningún lado (ver app/api/leads/route.ts).

# Notificación por correo (Resend) — opcional pero recomendado.
RESEND_API_KEY=
# Destinatario interno que recibe cada lead nuevo.
LEADS_TO_EMAIL=
# Remitente. Si se deja vacío usa el dominio de pruebas de Resend
# (onboarding@resend.dev), que funciona pero no es apto para producción real.
LEADS_FROM_EMAIL=

# Persistencia real en el CRM de Fenalco Santander (fenalco-crm / NEXO) —
# opcional, pero es la única persistencia real del lead más allá del correo.
# CRM_API_BASE_URL: URL del backend fenalco-crm (Render).
# CRM_API_KEY: debe coincidir con SATELITE_API_KEY configurada en fenalco-crm.
# CRM_EVENT_SLUG: slug del evento ya sembrado en fenalco-crm para la rueda de
#   negocios real (scripts/seed-conexiones-bga-evento.js) — NO usar
#   "conexiones-bga-2026", que en el CRM pertenece a otro evento (la reunión
#   interna de Socialización del 10 de septiembre).
CRM_API_BASE_URL=
CRM_API_KEY=
CRM_EVENT_SLUG=conexiones-bga-evento-2026
# CRM_SPONSOR_SLUG: slug del formulario de PATROCINADORES (modelo Patrocinador,
# distinto de Inscrito) para leads con interestType != 'participar'
# (patrocinio/expositor/alianza/comercial) — scripts/seed-conexiones-bga-patrocinadores.js
# en fenalco-crm. Opcional: si se deja vacío, usa CRM_EVENT_SLUG (mismo valor,
# es un campo de Evento distinto, sin colisión).
CRM_SPONSOR_SLUG=
